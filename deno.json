{
  "workspace": [
    "packages/dexcom",
    "packages/dexcom-mcp"
  ],
  "nodeModulesDir": "none",
  "exclude": [
    ".scratch/"
  ],
  "unstable": [
    "kv"
  ],
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run packages/dexcom-mcp/src/index.ts",
    "start:http": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run packages/dexcom-mcp/src/index.ts --http",
    "dev": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run --watch packages/dexcom-mcp/src/index.ts",
    "dev:http": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run --watch packages/dexcom-mcp/src/index.ts --http --host 127.0.0.1",
    "login": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run packages/dexcom-mcp/src/index.ts login",
    "build": "deno compile --unstable-kv --allow-net --allow-env --allow-read --allow-write --allow-run --output=packages/dexcom-mcp/dexcom-mcp packages/dexcom-mcp/src/index.ts",
    "check": "deno check packages/dexcom/mod.ts packages/dexcom-mcp/src/index.ts",
    "fmt": "deno fmt",
    "lint": "deno lint packages",
    "test": "deno test --allow-net --allow-env --allow-read",
    "publish:check": "deno publish --dry-run --allow-dirty",
    "hooks:install": "deno run --allow-read=deno.json,.git/hooks/ --allow-write=.git/hooks/ jsr:@hongminhee/deno-task-hooks@0.1.2",
    "hooks:pre-commit": "deno task check && deno fmt --check && deno task lint",
    "hooks:pre-push": "deno task publish:check"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true
  },
  "fmt": {
    "exclude": [
      "**/CHANGELOG.md",
      ".scratch/"
    ]
  },
  "lint": {
    "include": [
      "packages/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "imports": {
    "@logtape/logtape": "jsr:@logtape/logtape@^2.0.4",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
