# Dexcom developer app credentials (https://developer.dexcom.com)
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
# us | eu | jp | sandbox
DEXCOM_REGION=sandbox

# HTTP mode: public origin of this server (no path). Register
# {MCP_PUBLIC_URL}/oauth/dexcom/callback as a redirect URI in the Dexcom app.
MCP_PUBLIC_URL=http://localhost:3000
# Browser Origin hostnames allowed to call /mcp
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
# MCP token lifetimes in seconds
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL=2592000

# Stdio mode: loopback redirect URI used by `dexcom-mcp login`
DEXCOM_REDIRECT_URI=http://localhost:8765/callback

# Deno KV location (file path, :memory:, or a remote KV URL). Defaults to a
# per-user data directory: ~/Library/Application Support/dexcom-mcp/ (macOS),
# $XDG_DATA_HOME or ~/.local/share/dexcom-mcp/ (Linux).
# DEXCOM_MCP_KV_PATH=
